{
  "Bot": {
    "Token": "",
    "Username": "",
    "AllowedUpdates": [ "Message" ],
    "GroupMentionRequired": true
  },
  "Gemini": {
    "ExecutablePath": "gemini.cmd",
    "Model": "gemini-3-pro-preview",
    "UseHeadless": true,
    "PromptTimeoutSeconds": 120,
    "OutputFormat": "text"
  },
  "ChatHistory": {
    "DatabasePath": "data\\chat-history.db",
    "MaxMessages": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
